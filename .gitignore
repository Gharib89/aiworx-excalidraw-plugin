node_modules/
.claude/worktrees/
*.png
!brand/*.png
*.log

# The browser bundle ships with the plugin so an install needs no build step.
# ~/.gitignore_global ignores dist/, so un-ignore it here explicitly.
!dist/
!dist/excalidraw-page.js
!dist/index.html
!dist/fonts/**
.DS_Store

# bench runs commit the scene, SVG and metrics; the transcript is review output
bench/**/transcript.jsonl

# the grader keeps its raw samples and stderr beside the grade it merged them into
bench/**/grade-*.jsonl
bench/**/grade-*.log
bench/**/grade-*.json.part
