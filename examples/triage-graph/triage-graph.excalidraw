    {
      "id": "p2-21",
      "type": "text",
      "x": 1050,
      "y": 549.5,
      "width": 418.509521484375,
      "height": 157.95000000000002,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-11",
      "index": "aX",
      "roundness": null,
      "seed": 1652608776,
      "version": 2,
      "versionNonce": 2133049795,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Same states, same transitions, three different numbers — placement\nand routeGap are the same in both. gap spaces the states inside a\nlayer, layerGap spaces the layers themselves, routeGap spaces two\nroutes sharing one corridor, and direction turns the flow on its side. The\nengine routes and the label clearances both follow on their own, which\nis the whole point: the fractions this panel used to carry had to be\npicked again from scratch here, because a fraction runs along\nwhichever edge now faces its target — a measured extent is read the\nsame way in either direction.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same states, same transitions, three different numbers — placement\nand routeGap are the same in both. gap spaces the states inside a\nlayer, layerGap spaces the layers themselves, routeGap spaces two\nroutes sharing one corridor, and direction turns the flow on its side. The\nengine routes and the label clearances both follow on their own, which\nis the whole point: the fractions this panel used to carry had to be\npicked again from scratch here, because a fraction runs along\nwhichever edge now faces its target — a measured extent is read the\nsame way in either direction.",
      "autoResize": true,
      "lineHeight": 1.35
    },
