    {
      "id": "p1-10",
      "type": "text",
      "x": 0,
      "y": 580.5,
      "width": 419.7574462890625,
      "height": 175.5,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-0",
      "index": "aG",
      "roundness": null,
      "seed": 1680690999,
      "version": 2,
      "versionNonce": 319338615,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787905930343,
      "link": null,
      "locked": false,
      "text": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and the engine\nalready gives that pair two ports of its own; originAt / landAt do the\ntwo things the engine cannot: spread the four legs leaving needs-triage\nacross its facing edge, and move them clear of each other's labels,\nwhich ELK spaced its ports without ever being told about. needs-triage\nleads because modelOrder makes the order the states were listed in\nthe tie-break, and that order picks which edge of the cycle gives way —\nthe picture opens where an issue really opens.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and the engine\nalready gives that pair two ports of its own; originAt / landAt do the\ntwo things the engine cannot: spread the four legs leaving needs-triage\nacross its facing edge, and move them clear of each other's labels,\nwhich ELK spaced its ports without ever being told about. needs-triage\nleads because modelOrder makes the order the states were listed in\nthe tie-break, and that order picks which edge of the cycle gives way —\nthe picture opens where an issue really opens.",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
