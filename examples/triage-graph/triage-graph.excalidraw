      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-0",
      "index": "aG",
      "roundness": null,
      "seed": 67584667,
      "version": 2,
      "versionNonce": 1019836463,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every edge follows the corridor the engine left when it placed the\nnodes — read back, not redrawn, so nothing here is hand-routed and\nnothing here is hand-nudged. The five labels come from label(), which\nmeasures the text and hands graph() a width and a height; graph()\ngives the engine those, and the engine spaces its ports around the\nroom they need. That is what retired the four originAt / landAt this\nband used to carry: a fraction was only ever standing in for a width\nnobody had measured, and it cost the edge its engine route to do it.\nneeds-triage leads because modelOrder makes the order the states\nwere listed in the tie-break, and that order picks which edge of the\ncycle gives way — the picture opens where an issue really opens.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every edge follows the corridor the engine left when it placed the\nnodes — read back, not redrawn, so nothing here is hand-routed and\nnothing here is hand-nudged. The five labels come from label(), which\nmeasures the text and hands graph() a width and a height; graph()\ngives the engine those, and the engine spaces its ports around the\nroom they need. That is what retired the four originAt / landAt this\nband used to carry: a fraction was only ever standing in for a width\nnobody had measured, and it cost the edge its engine route to do it.\nneeds-triage leads because modelOrder makes the order the states\nwere listed in the tie-break, and that order picks which edge of the\ncycle gives way — the picture opens where an issue really opens.",
      "autoResize": true,
      "lineHeight": 1.35
    },
