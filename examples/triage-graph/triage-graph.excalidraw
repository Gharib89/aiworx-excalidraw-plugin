      "seed": 1796785746,
      "version": 2,
      "versionNonce": 1005421522,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786530168845,
      "link": null,
      "locked": false,
      "text": "Same states, same transitions, three different numbers. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side — after which every originAt /\nlandAt above had to be picked again, because a fraction runs along\nwhichever edge now faces its target.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same states, same transitions, three different numbers. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side — after which every originAt /\nlandAt above had to be picked again, because a fraction runs along\nwhichever edge now faces its target.",
      "autoResize": true,
      "lineHeight": 1.35
    },
