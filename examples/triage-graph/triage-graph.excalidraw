    {
      "id": "p2-21",
      "type": "text",
      "x": 1029.5234375,
      "y": 532.5,
      "width": 414.7134094238281,
      "height": 105.30000000000001,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-11",
      "index": "aX",
      "roundness": null,
      "seed": 385097445,
      "version": 2,
      "versionNonce": 480987813,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787905408913,
      "link": null,
      "locked": false,
      "text": "Same states, same transitions, three different numbers. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side. The engine routes follow on their\nown, because they are read back from the layout rather than written\nbeside it — every originAt / landAt above still had to be picked again,\nbecause a fraction runs along whichever edge now faces its target.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same states, same transitions, three different numbers. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side. The engine routes follow on their\nown, because they are read back from the layout rather than written\nbeside it — every originAt / landAt above still had to be picked again,\nbecause a fraction runs along whichever edge now faces its target.",
      "autoResize": true,
      "lineHeight": 1.35
    },
