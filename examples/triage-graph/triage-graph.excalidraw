    {
      "id": "p1-10",
      "type": "text",
      "x": 0,
      "y": 580.5,
      "width": 405.60040283203125,
      "height": 105.30000000000001,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
