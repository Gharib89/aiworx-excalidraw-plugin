    {
      "id": "p2-21",
      "type": "text",
      "x": 1086.2578125,
      "y": 556.5,
      "width": 414.3233947753906,
      "height": 122.85000000000001,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-11",
      "index": "aX",
      "roundness": null,
      "seed": 2147009144,
      "version": 2,
      "versionNonce": 2039127160,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788177440877,
      "link": null,
      "locked": false,
      "text": "Same states, same transitions, three different numbers — placement is\nthe fourth option and deliberately the same in both. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side. The engine routes follow on their\nown, because they are read back from the layout rather than written\nbeside it — every originAt / landAt above still had to be picked again,\nbecause a fraction runs along whichever edge now faces its target.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same states, same transitions, three different numbers — placement is\nthe fourth option and deliberately the same in both. gap spaces the\nstates inside a layer, layerGap spaces the layers themselves, and\ndirection turns the flow on its side. The engine routes follow on their\nown, because they are read back from the layout rather than written\nbeside it — every originAt / landAt above still had to be picked again,\nbecause a fraction runs along whichever edge now faces its target.",
      "autoResize": true,
      "lineHeight": 1.35
    },
