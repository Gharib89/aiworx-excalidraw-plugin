    {
      "id": "p1-10",
      "type": "text",
      "x": 0,
      "y": 580.5,
      "width": 416.7674560546875,
      "height": 157.95000000000002,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-0",
      "index": "aG",
      "roundness": null,
      "seed": 794741323,
      "version": 2,
      "versionNonce": 1842774667,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787905408913,
      "link": null,
      "locked": false,
      "text": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and the engine\nalready gives that pair two ports of its own; originAt / landAt only\nmove the neighbouring legs clear of its labels, the one thing the engine\ncannot do for itself because nobody told it the labels are there.\nneeds-triage leads because modelOrder makes the order the states\nwere listed in the tie-break, and that order picks which edge of the\ncycle gives way — the picture opens where an issue really opens.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and the engine\nalready gives that pair two ports of its own; originAt / landAt only\nmove the neighbouring legs clear of its labels, the one thing the engine\ncannot do for itself because nobody told it the labels are there.\nneeds-triage leads because modelOrder makes the order the states\nwere listed in the tie-break, and that order picks which edge of the\ncycle gives way — the picture opens where an issue really opens.",
      "autoResize": true,
      "lineHeight": 1.35
    },
