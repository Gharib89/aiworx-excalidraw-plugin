    {
      "id": "p1-10",
      "type": "text",
      "x": 0,
      "y": 580.5,
      "width": 417.74237060546875,
      "height": 140.4,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
