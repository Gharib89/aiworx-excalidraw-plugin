    {
      "id": "p1-10",
      "type": "text",
      "x": 0,
      "y": 729.5,
      "width": 411.242431640625,
      "height": 193.05,
      "angle": 0,
      "strokeColor": "#5B5B58",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
