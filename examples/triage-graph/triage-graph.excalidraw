      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-0",
      "index": "aG",
      "roundness": null,
      "seed": 457722484,
      "version": 2,
      "versionNonce": 1744839028,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787838025689,
      "link": null,
      "locked": false,
      "text": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and left alone both\nlegs run down one line; originAt / landAt move the return leg onto the\noutside of the fan, the one thing the engine cannot do for itself because\nnobody told it the labels are there. ready-for-agent sits on top because\nthe engine reversed an edge to break the cycle: read the arrowheads,\nnot the layers.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every unoffset edge follows the corridor the engine left when it placed\nthe nodes — read back, not redrawn, so no edge here is hand-routed.\nneeds-triage and needs-info point at each other, and left alone both\nlegs run down one line; originAt / landAt move the return leg onto the\noutside of the fan, the one thing the engine cannot do for itself because\nnobody told it the labels are there. ready-for-agent sits on top because\nthe engine reversed an edge to break the cycle: read the arrowheads,\nnot the layers.",
      "autoResize": true,
      "lineHeight": 1.35
    },
