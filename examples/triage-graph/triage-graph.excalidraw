      "index": "aG",
      "roundness": null,
      "seed": 285046960,
      "version": 2,
      "versionNonce": 1159199920,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786530910734,
      "link": null,
      "locked": false,
      "text": "needs-triage and needs-info point at each other, and left alone both\nlegs run down one line — the return arrow straight through the\noutgoing leg's label. originAt / landAt move the return leg onto the\noutside of the fan, where it has a line to itself. ready-for-agent sits on\ntop because the engine reversed an edge to break the cycle: read the\narrowheads, not the layers.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "needs-triage and needs-info point at each other, and left alone both\nlegs run down one line — the return arrow straight through the\noutgoing leg's label. originAt / landAt move the return leg onto the\noutside of the fan, where it has a line to itself. ready-for-agent sits on\ntop because the engine reversed an edge to break the cycle: read the\narrowheads, not the layers.",
      "autoResize": true,
      "lineHeight": 1.35
    },
